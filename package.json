{
  "name": "obsidian-wpm-rt",
  "version": "0.1.0",
  "description": "Realtime WPM status bar and typing stats for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "install:vault": "scripts/install-obsidian-plugin"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "wpm",
    "typing"
  ],
  "author": "miaobo",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@types/node": "^22.7.5",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.11",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.3"
  }
}
